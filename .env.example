# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=<your-databricks-token>

# TODO: Update with the MLflow experiment you want to log traces and models to
MLFLOW_EXPERIMENT_ID=

# REQUIRED: Databricks Supervisor Agent (Agent Bricks Multi-Agent Supervisor) serving endpoint
# that the backend proxy forwards to. The backend refuses to start if this is unset. In a
# Databricks Apps deployment the DAB injects this from the `supervisor_endpoint_name` bundle var.
SUPERVISOR_ENDPOINT_NAME=

# --- Persistent chat history (Lakebase), optional for local dev ---
# Persistent mode stores chat history in Lakebase; without it the app runs in Ephemeral mode
# (in-memory history, an "Ephemeral" badge in the UI).
#
# Easiest: set LAKEBASE_INSTANCE_NAME to a Lakebase instance you can access. On `uv run start-app`
# the launcher resolves its host via the Databricks CLI and enters Persistent mode automatically;
# if the instance can't be found it falls back to Ephemeral mode.
# LAKEBASE_INSTANCE_NAME=sa-chat-lakebase-dev-<username>
#
# Advanced: set the Postgres connection explicitly instead (skips auto-resolution).
# PGHOST is the instance's read_write_dns — get it via `./frontend/scripts/get-pghost.sh <instance>`.
# PGUSER defaults to your Databricks username locally; PGDATABASE/PGPORT default as shown.
# PGHOST=your-lakebase-host
# PGUSER=your-databricks-username
# PGDATABASE=databricks_postgres
# PGPORT=5432

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"
